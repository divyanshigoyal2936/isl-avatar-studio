# Server Configuration
APP_NAME="ISL Avatar Studio"
APP_VERSION="1.0.0"
DEBUG=true

# Database (defaults to local SQLite if PostgreSQL not configured)
DATABASE_URL="sqlite:///./isl_avatar.db"
# Example PostgreSQL: postgresql://isl_user:secret_password@localhost:5432/isl_avatar_db

# RAG & Embeddings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
FAISS_TOP_K=3
FAISS_SIMILARITY_THRESHOLD=0.50

# Speech-to-Text
STT_PROVIDER="whisper"
STT_MAX_AUDIO_SIZE_BYTES=15728640
